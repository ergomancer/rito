{
  "name": "rito",
  "version": "0.1.0",
  "description": "A text based social media engine.",
  "main": "app/app.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npx tsx --env-file=.env --watch  app/app.ts",
    "build": "npx tsc",
    "start": "node build/app.js",
    "migrate": "pnpm env-cmd -f .env pnpm dlx prisma migrate dev && npx prisma generate",
    "studio": "pnpm env-cmd -f .env pnpm dlx prisma studio",
    "seed": "pnpm env-cmd -f .env pnpm dlx tsx ./app/.local/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "env-cmd": "^11.0.0",
    "prisma": "^7.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}